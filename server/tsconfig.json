{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "module": "NodeNext",
    "baseUrl": "src",
    "moduleResolution": "NodeNext",
    "sourceMap": true,
    "noImplicitAny": false,
    "typeRoots": [
      "./src/types",
      "../node_modules/@types"
    ]
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}